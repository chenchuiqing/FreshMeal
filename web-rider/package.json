{
  "name": "freshmeal-web-rider",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "oxlint",
    "typecheck": "vue-tsc --noEmit",
    "check": "oxlint && vue-tsc --noEmit && vitest run && vite build",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "axios": "1.20.0",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "vant": "^4.10.2",
    "vue": "^3.5.45",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^27.4.0",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.92.0",
    "sass": "1.93.2",
    "typescript": "5.9.3",
    "vite": "^8.3.6",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.3.14"
  },
  "browserslist": [
    "iOS >= 15",
    "Android >= 8",
    "Chrome >= 80"
  ],
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=9.12.0"
  },
  "packageManager": "pnpm@9.15.9",
  "pnpm": {
    "overrides": {
      "axios": "1.20.0",
      "brace-expansion@>=2 <3": "2.1.4",
      "brace-expansion@>=5 <6": "5.0.9",
      "defu": "6.1.5",
      "esbuild": "0.28.2",
      "js-cookie": "3.0.7",
      "js-yaml": "4.3.1",
      "lodash": "4.18.0",
      "picomatch@<3": "2.3.2",
      "picomatch@>=4 <5": "4.0.4",
      "postcss": "8.5.26",
      "qs": "6.15.2",
      "uuid": "13.0.1"
    }
  }
}
