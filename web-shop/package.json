{
  "name": "freshmeal-web-shop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint && stylelint --cache \"src/**/*.{vue,scss,css}\" --cache-location node_modules/.cache/stylelint/",
    "lint:code": "oxlint",
    "lint:styles": "stylelint --cache \"src/**/*.{vue,scss,css}\" --cache-location node_modules/.cache/stylelint/",
    "lint:fix": "oxlint --fix && stylelint --fix \"src/**/*.{vue,scss,css}\" --cache-location node_modules/.cache/stylelint/",
    "typecheck": "vue-tsc --build",
    "check": "oxlint && stylelint --cache \"src/**/*.{vue,scss,css}\" --cache-location node_modules/.cache/stylelint/ && vue-tsc --build && vitest run && vite build",
    "api:generate": "openapi-typescript openapi/schema.yaml -o src/types/api/generated.d.ts && oxfmt --write src/types/api/generated.d.ts",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@tanstack/vue-query": "^5.107.1",
    "axios": "1.20.0",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "vant": "^4.10.2",
    "vue": "^3.5.45",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@stylistic/stylelint-plugin": "^4.0.1",
    "@tsconfig/node22": "^22.0.5",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^24.19.2",
    "@vant/auto-import-resolver": "^1.3.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^4.1.12",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.8.1",
    "autoprefixer": "^10.6.2",
    "eslint-plugin-command": "^3.5.3",
    "jsdom": "^27.4.0",
    "openapi-typescript": "^7.13.0",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.92.0",
    "oxlint-tsgolint": "7.0.2005",
    "postcss": "8.5.26",
    "postcss-html": "1.8.1",
    "postcss-scss": "^4.0.9",
    "sass": "1.93.2",
    "stylelint": "^16.26.1",
    "stylelint-config-recess-order": "^7.10.0",
    "stylelint-config-recommended": "^17.0.0",
    "stylelint-config-recommended-scss": "^16.0.0",
    "stylelint-config-recommended-vue": "^1.5.0",
    "stylelint-config-standard": "^39.0.1",
    "stylelint-order": "^7.0.1",
    "stylelint-scss": "^6.14.0",
    "typescript": "5.9.3",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.6",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-progress": "^0.0.7",
    "vite-plugin-svg-icons": "^2.0.1",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.3.14"
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=9.12.0"
  },
  "browserslist": [
    "iOS >= 15",
    "Android >= 8",
    "Chrome >= 80"
  ],
  "pnpm": {
    "overrides": {
      "axios": "1.20.0",
      "brace-expansion@>=2 <3": "2.1.4",
      "brace-expansion@>=5 <6": "5.0.9",
      "defu": "6.1.5",
      "esbuild": "0.28.2",
      "js-cookie": "3.0.7",
      "js-yaml": "4.3.1",
      "lodash": "4.18.0",
      "picomatch@<3": "2.3.2",
      "picomatch@>=4 <5": "4.0.4",
      "postcss": "8.5.26",
      "qs": "6.15.2",
      "uuid": "13.0.1"
    }
  }
}
